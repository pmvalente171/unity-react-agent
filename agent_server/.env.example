OPENAI_API_KEY=sk-...
# Optional: pick a model card from config/models.yaml instead of its `active` entry
# ACTIVE_MODEL=gpt-4.1-mini

# vLLM server (model card "gemma")
# VLLM_HOST=https://<host>/<path>/v1
# VLLM_API_KEY=

# Ollama server (model card "ollama"); the header's name and value are both secret
# OLLAMA_HOST=https://<host>/ollama
# OLLAMA_HEADER_KEY=
# OLLAMA_HEADER_VALUE=
