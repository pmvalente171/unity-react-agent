/* Chat panel (bottom-right). Reference resolution is 1920x1080 (PanelSettings). */
.chat {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 560px;
    height: 680px;
    padding: 12px;
    flex-direction: column;
    background-color: rgba(18, 18, 24, 0.92);
    border-radius: 10px;
}

.chat__messages {
    flex-grow: 1;
}

.chat__status {
    margin: 4px 2px;
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(170, 170, 190);
}

.chat__input-row {
    flex-direction: row;
    margin-top: 6px;
}

.chat__input {
    flex-grow: 1;
    margin: 0 6px 0 0;
    font-size: 18px;
}

.chat__send {
    width: 90px;
    margin: 0;
    font-size: 18px;
}

/* Messages. ChatBox adds .chat-message plus one modifier class per message. */
.chat-message {
    margin: 0 0 8px 0;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
}

.chat-message__sender {
    margin: 0 0 2px 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(170, 170, 190);
}

.chat-message__text {
    margin: 0;
    padding: 0;
    white-space: normal;
    font-size: 17px;
    color: rgb(235, 235, 240);
}

.chat-message--user {
    margin-left: 60px;
    background-color: rgba(70, 110, 200, 0.40);
}

.chat-message--agent {
    margin-right: 60px;
    background-color: rgba(255, 255, 255, 0.12);
}

.chat-message--thought {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 3px;
    border-left-color: rgb(120, 120, 160);
}

.chat-message--thought .chat-message__text {
    -unity-font-style: italic;
    color: rgb(190, 190, 210);
}

.chat-message--action {
    background-color: rgba(200, 150, 40, 0.20);
}

.chat-message--observation {
    background-color: rgba(60, 160, 110, 0.20);
}

.chat-message--error {
    background-color: rgba(200, 60, 60, 0.35);
}

.chat-message--system {
    background-color: rgba(0, 0, 0, 0);
    padding: 2px 10px;
}

.chat-message--system .chat-message__text {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(140, 140, 155);
}
