<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/ChatboxStyle.uss?fileID=7433441132597879392&amp;guid=0e08369787202a6489793e52f1f10b9c&amp;type=3#ChatboxStyle"/>
    <ui:VisualElement name="chat" class="chat">
        <ui:ScrollView name="messages" class="chat__messages" mode="Vertical" horizontal-scroller-visibility="Hidden"/>
        <ui:Label name="status" class="chat__status" text=""/>
        <ui:VisualElement name="input-row" class="chat__input-row">
            <ui:TextField name="input" class="chat__input" placeholder-text="Ask the agent... (/stop, /reset)"/>
            <ui:Button name="send" class="chat__send" text="Send"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
